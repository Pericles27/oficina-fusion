# Oficina Fusion — API Environment Variables
# Copiar a frontend/.env.production y completar antes de un deploy.
# Estas variables son leídas por el frontend (NEXT_PUBLIC_*).

# URL base de la API del backend (Fly.io)
# Cuando se deployea en Netlify, las requests a /api/* se redirigen
# automáticamente por netlify.toml — pero es útil tenerlo para desarrollo local.
NEXT_PUBLIC_API_URL=https://oficina-fusion-backend.fly.dev/api

# URL de la app (para redirects, social, etc.)
NEXT_PUBLIC_APP_URL=https://oficina-fusion.netlify.app
