# =============================================================
# Oficina Fusion — Backend (NestJS) — Variables de entorno de PRODUCCIÓN
#
# Copiar a backend/.env.production y completar antes de un deploy que NO
# use docker-compose.prod.yml (ej. deploy directo del backend a un host/
# PaaS). Si se usa docker-compose.prod.yml, estas variables se inyectan
# automáticamente desde el .env.production de la raíz — este archivo es
# la referencia de qué necesita el proceso `node dist/main`.
# =============================================================

# Cadena de conexión completa a Postgres de producción.
# Formato: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_RANDOM_PASSWORD@db:5432/oficina_fusion

# Secreto usado para firmar/verificar JWT. Generar con: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# Origen permitido por CORS (debe ser la URL pública del frontend).
FRONTEND_URL=https://oficina.example.com

# Puerto en el que escucha el proceso Nest.
PORT=3001

NODE_ENV=production
