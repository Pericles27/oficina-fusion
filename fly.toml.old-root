# fly.toml configuration for Oficina Fusion Backend
app = "oficina-fusion-backend"
primary_region = "gru" # São Paulo (región más cercana a Argentina)
kill_signal = "SIGINT"
kill_timeout = 5

[build]
  dockerfile = "Dockerfile.fly"

[env]
  PORT = "3001"
  NODE_ENV = "production"

[http_service]
  internal_port = 3001
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 0
  processes = ["app"]

[[vm]]
  memory = "512mb"
  cpu = "1 shared"

[mounts]
  source = "data"
  destination = "/app/data"

[processes]
  app = ""
