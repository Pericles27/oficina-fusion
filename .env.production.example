# =============================================================
# Oficina Fusion — Variables de entorno de PRODUCCIÓN (raíz)
#
# Usadas por docker-compose.prod.yml. Copiar a `.env.production` y
# completar con valores reales antes de desplegar:
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# NUNCA commitear `.env.production` con secretos reales al repositorio.
# =============================================================

# --- Postgres ---
POSTGRES_USER=postgres
# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_DB=oficina_fusion

# --- Backend / JWT ---
# Generar con: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
BACKEND_PORT=3001

# URL pública del frontend (usada por el backend para configurar CORS)
FRONTEND_URL=https://oficina.example.com

# --- Frontend ---
# Base URL que el frontend usa para llamar a la API. Si se sirve todo
# detrás de nginx (ver nginx/nginx.conf, location /api/), usar "/api".
NEXT_PUBLIC_API_URL=/api

# --- Nginx / puertos públicos ---
HTTP_PORT=80
HTTPS_PORT=443

# --- DATABASE_URL derivada (informativa; docker-compose.prod.yml la arma
#     automáticamente a partir de POSTGRES_* + el hostname interno `db`) ---
# DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/oficina_fusion
